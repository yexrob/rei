{
  "name": "bingo-gui",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop workspace for bingo",
  "author": "bingo",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/prepare-native.cjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --config electron-builder.cjs",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.cjs",
    "test:e2e": "npm run build && playwright test",
    "protocol:generate": "node scripts/generate-rpc.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.41.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "write-file-atomic": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^4.1.10"
  }
}
